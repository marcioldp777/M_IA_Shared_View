{
  "name": "samsung_compartilhamento_tela",
  "version": "1.0.0",
  "description": "M I.A. Shared View: apresentação na TV pela rede local (Samsung Tizen e Android TV) com WebRTC",
  "main": "desktop.js",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "prepare:tv": "node scripts/prepare-tv.js",
    "desktop": "electron .",
    "build:windows": "electron-builder --win portable",
    "build:android": "node scripts/build-android.js"
  },
  "keywords": [],
  "author": "Marcio Lourenço (M I.A. Solutions)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "koffi": "^2.16.3",
    "node-forge": "^1.4.2",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.sala.tv",
    "productName": "M I.A. Shared View",
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "executableName": "Sala TV",
    "files": [
      "package.json",
      "desktop.js",
      "server.js",
      "tools.js",
      "*-preload.js",
      "installer/**",
      "public/**",
      "assets/**",
      "tv/config.xml",
      "tv/index.html",
      "tv/icon.png"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcioldp777/M_IA_Shared_View.git"
  }
}
